<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data></data>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:foreground="?attr/selectableItemBackground"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        android:backgroundTint="@android:color/white">

        <LinearLayout
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- 🔹 USER DETAILS -->
            <TextView
                android:id="@+id/tvUserName"
                android:text="Ishmee"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#222222"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvUserAddress"
                android:text="Bhilwara Rajasthan"
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="2dp" />

            <TextView
                android:id="@+id/tvUserRestaurent"
                android:text="Hash Caffe"
                android:textSize="14sp"
                android:textColor="#FF5963"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="2dp" />

            <!-- 🔹 DISH ITEMS LIST -->
            <LinearLayout
                android:id="@+id/itemsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp" />

            <!-- 🔹 TXN ID -->
            <TextView
                android:id="@+id/tvTransactionId"
                android:text="Txn ID: TXN176277964583282"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <!-- 🔹 DELIVERY INFO -->
            <TextView
                android:id="@+id/tvOrderTime"
                android:text="Delivered on: 10 Nov 2025, 09:24 AM"
                android:textSize="12sp"
                android:textColor="#888888"
                android:paddingTop="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp">



            <TextView
                android:id="@+id/tvOrderId"
                android:text="Order ID: #27jkjkcj73"
                android:textSize="12sp"
                android:textColor="#888888"
                android:paddingTop="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
                <TextView
                    android:id="@+id/tvUserCommission"
                    android:text="Order ID: #cfcvcvcv 3"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:paddingTop="21dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />



                <LinearLayout
                    android:id="@+id/rightSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:id="@+id/tvAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹990.0"
                        android:textColor="#2E7D32"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPaymentMode"
                        android:text="COD"
                        android:textSize="14sp"
                        android:textColor="#555555"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="2dp" />
                </LinearLayout>
            </RelativeLayout>



            <!--    <TextView
                    android:id="@+id/tvUserCommission"
                    android:text="Driver Commission: ₹0.0"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#888888"
                    android:layout_alignParentStart="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />-->


        </LinearLayout>
    </androidx.cardview.widget.CardView>
</layout>
