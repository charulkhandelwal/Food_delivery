<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data></data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@drawable/order_item_bg"
        android:layout_margin="8dp"
        android:elevation="2dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvorderId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Order #101"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="#000000" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pickup Pending"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textSize="12sp"
                android:background="@drawable/status_pending_bg"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp" />

            <ImageView
                android:id="@+id/ivexpandIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/spinner"
                app:tint="#888888" />
        </LinearLayout>

        <!-- Expanded details (hidden by default) -->
        <LinearLayout
            android:id="@+id/layoutdetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/tvcustomerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pizza Center"
                android:textStyle="bold"
                android:textColor="#000000" />

            <TextView
                android:id="@+id/tvItems"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 x Pizza, 1 x Coke"
                android:textColor="#555555" />

            <TextView
                android:id="@+id/tvprice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹250"
                android:layout_marginTop="6dp"
                android:textStyle="bold"
                android:textColor="#4CAF50" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_location"
                    app:tint="#757575"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/tvAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Address"
                    android:textColor="#444444" />
            </LinearLayout>

            <!-- NEW: Pickup Location -->
            <TextView
                android:id="@+id/tvPickupLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pickup: 19.076, 72.877"
                android:textColor="#555555"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/btnConfirmPickup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confirm Pickup"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_red_rounded" />
        </LinearLayout>
    </LinearLayout>
</layout>
