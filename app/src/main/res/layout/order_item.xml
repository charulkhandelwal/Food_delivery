<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/order_item_bg"
    android:layout_margin="8dp">

    <!-- Order Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tvorderid"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Order #123"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000" />

        <ImageView
            android:id="@+id/ivexpandIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/spinner"
            app:tint="#888888" />
    </LinearLayout>

    <!-- Customer Info / Items / Address -->
    <LinearLayout
        android:id="@+id/layoutdetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/tvCustomerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aman Sharma"
            android:textSize="14sp"
            android:textColor="#444444"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvitems"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Besan Ladoo - Qty: 2"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvprice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹ 2300 Paid"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#4CAF50"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No address selected yet"
            android:textSize="14sp"
            android:textColor="#000000"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/btnConfirmPickup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confirm Pickup"
            android:background="@drawable/btn_red_rounded"
            android:padding="8dp"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

</LinearLayout>
