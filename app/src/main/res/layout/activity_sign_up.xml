<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
    </data>

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_top_gradient">

        <ImageView
            android:id="@+id/Iv_landing"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.2"
            android:src="@drawable/landing"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:padding="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_bottom_white_wave"
            android:padding="24dp">

            <TextView
                android:id="@+id/txt1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Be a EatFit Partner"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#444" />

            <TextView
                android:id="@+id/txt2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Get a stable monthly income"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#000" />

            <!-- Phone input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/phoneinputlayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:hint="e.g. 9999988888">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etphone"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:inputType="phone"
                    android:maxLength="10"
                    android:textColor="#000"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Terms checkbox -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <CheckBox
                    android:id="@+id/checkboxterms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/txtprivacy1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="By signing up I agree to the "
                    android:textSize="12sp"
                    android:textColor="#555" />

                <TextView
                    android:id="@+id/txtprivacy2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Terms of use"
                    android:textSize="10sp"
                    android:textColor="#FF4A5C"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtprivacy3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="and"
                    android:textSize="12sp"
                    android:textColor="#555" />

                <TextView
                    android:id="@+id/txtprivacy4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Privacy Policy"
                    android:textSize="10sp"
                    android:textColor="#FF4A5C"
                    android:textStyle="bold" />
            </LinearLayout>


            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnsendotp"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/btn_red_rounded"
                android:text="Send OTP"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

        </LinearLayout>
    </LinearLayout>
</layout>
