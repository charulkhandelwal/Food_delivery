<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:background="@drawable/bg_refer_gradient">

            <ImageView
                android:id="@+id/ivCharacter"
                android:layout_width="140dp"
                android:layout_height="200dp"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="20dp"
                android:layout_alignParentBottom="true"
                android:src="@drawable/refer"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_marginStart="20dp"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtTitle"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:text="Refer &amp; Earn"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:gravity="center_vertical"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtSub"
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:layout_marginTop="4dp"
                    android:text="Upto ₹100"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center_vertical"/>

                <View
                    android:layout_width="70dp"
                    android:layout_height="2dp"
                    android:background="@android:color/white"
                    android:layout_marginTop="6dp"/>

                <TextView
                    android:id="@+id/txtDesc"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginTop="8dp"
                    android:text="Invite your friends to use EatFit Partner App &amp; get Rs. 75 when your friend uses your referral code and completes a successful delivery."
                    android:textColor="@android:color/white"
                    android:textSize="12sp"/>

                <Button
                    android:id="@+id/btnReferNow"
                    android:layout_width="160dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@android:color/black"
                    android:text="Refer Now"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"/>
            </LinearLayout>
        </RelativeLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic3" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:text="Invite your friends to EatFit"
                    android:textColor="#000"
                    android:textSize="14sp"
                    android:gravity="center_vertical"/>
            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic1" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:text="Your friend uses your referral code"
                    android:textColor="#000"
                    android:textSize="14sp"
                    android:gravity="center_vertical"/>
            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic2" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:text="You get Rs. 75 in your wallet"
                    android:textColor="#000"
                    android:textSize="14sp"
                    android:gravity="center_vertical"/>
            </LinearLayout>
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:paddingHorizontal="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_referral_box"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your referral code"
                android:textColor="#888"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/txtReferralCode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="LOREM2331"
                android:textColor="#FF4A5C"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingStart="8dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCopy"
                android:layout_width="90dp"
                android:layout_height="36dp"
                android:text="Copy Code"
                android:textSize="12sp"
                android:textColor="@android:color/black"
                android:background="@drawable/bg_copy_btn"/>
        </LinearLayout>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:paddingStart="16dp"
            android:gravity="center_vertical"
            android:text="Frequently Asked Questions"
            android:textColor="#000"
            android:textSize="14sp"
            android:textStyle="bold"/>


        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView

                style="@style/faq_item"
                android:text="What is EatFit?"/>
            <TextView
                style="@style/faq_item"
                android:text="How to invite a user?"/>
            <TextView
                style="@style/faq_item"
                android:text="How to withdraw money from wallet?"/>
            <TextView
                style="@style/faq_item"
                android:text="How to know status of a query?"/>
            <TextView
                style="@style/faq_item"
                android:text="How to apply a referral code?"/>
            <TextView
                style="@style/faq_item"
                android:text="How to apply for a campaign?"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
