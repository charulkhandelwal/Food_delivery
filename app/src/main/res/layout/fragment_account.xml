                        android:src="@drawable/logout"
                        android:tint="@color/lightpink"
                        tools:ignore="UseAppTint" />

                    <TextView
                        android:id="@+id/Logout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
