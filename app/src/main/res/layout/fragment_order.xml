<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF">

        <!-- 🔹 Shimmer Layout ABOVE Everything -->
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            app:shimmer_auto_start="true"
            app:shimmer_base_alpha="0.7"
            app:shimmer_duration="1200"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginVertical="8dp"
                    android:background="@drawable/bg_shimmer_rect" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginVertical="8dp"
                    android:background="@drawable/bg_shimmer_rect" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginVertical="8dp"
                    android:background="@drawable/bg_shimmer_rect" />
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>

        <!-- 🔹 Main Layout -->
        <RelativeLayout
            android:id="@+id/layoutMain"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <TextView
                android:id="@+id/titleOrders"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:drawableStart="@drawable/beg"
                android:gravity="center_horizontal"
                android:padding="10dp"
                android:text="Orders"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- 🔹 No Orders -->
            <LinearLayout
                android:id="@+id/layoutNoOrders"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/titleOrders"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:src="@drawable/logoorder" />

                <TextView
                    android:id="@+id/nodata"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="No New Orders"
                    android:textColor="#333"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 🔹 Orders List -->
            <LinearLayout
                android:id="@+id/layoutOrderList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/titleOrders"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:padding="8dp">

                <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                    android:id="@+id/swipeRefreshLayout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerOrders"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingBottom="12dp"
                        tools:listitem="@layout/order_item" />
                </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
            </LinearLayout>
        </RelativeLayout>

        <!-- 🔹 Map Layout (unchanged) -->
        <LinearLayout
            android:id="@+id/layoutMapTracking"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="#FFFFFF">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="8dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_back"
                android:backgroundTint="@color/black" />

            <FrameLayout
                android:id="@+id/mapFragmentContainer"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginHorizontal="12dp"
                android:layout_marginBottom="8dp"
                android:background="#EEE"
                android:elevation="2dp" />

            <TextView
                android:id="@+id/tvMapSelectedAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#EEEEEE"
                android:padding="12dp"
                android:text="Restaurant: --"
                android:textColor="#000"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:dividerPadding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Restaurant Details"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@color/black" />

                    <TextView
                        android:id="@+id/tvRestaurantName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Name: -" />

                    <TextView
                        android:id="@+id/tvRestaurantAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Address: -" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#DDD"
                        android:layout_marginVertical="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Order Details"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@color/black" />

                    <TextView
                        android:id="@+id/tvOrderId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Order ID: -" />

                    <TextView
                        android:id="@+id/tvOrderAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Amount: -" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#DDD"
                        android:layout_marginVertical="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Delivery Details"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@color/black" />

                    <TextView
                        android:id="@+id/tvDeliveryAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Delivery Address: -" />
                </LinearLayout>
            </ScrollView>

            <Button
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:backgroundTint="#FF6B6B"
                android:text="Start Delivery"
                android:textAllCaps="false"
                android:textColor="#FFF" />

            <LinearLayout
                android:id="@+id/llView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:orientation="horizontal"
                android:weightSum="2"
                android:gravity="center">

                <Button
                    android:id="@+id/btnReached"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#FFA500"
                    android:text="Reached"
                    android:textAllCaps="false"
                    android:textColor="#FFF" />

                <Button
                    android:id="@+id/btnPicked"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="#4CAF50"
                    android:text="Picked"
                    android:textAllCaps="false"
                    android:textColor="#FFF" />
            </LinearLayout>

            <Button
                android:id="@+id/btnOrder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:backgroundTint="#FF6B6B"
                android:text="Order Delivered"
                android:textAllCaps="false"
                android:textColor="#FFF"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnPaymentReceive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:backgroundTint="#4CAF50"
                android:text="Payment complete"
                android:textAllCaps="false"
                android:textColor="#FFF"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnSendAmountToAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:backgroundTint="#FF6B6B"
                android:text="Pay to Admin"
                android:textAllCaps="false"
                android:textColor="#FFF"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnOrderCompleted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:backgroundTint="#4CAF50"
                android:text="Delivery Complete"
                android:textAllCaps="false"
                android:textColor="#FFF"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</layout>
